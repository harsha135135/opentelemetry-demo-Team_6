# Copy to .env (never commit .env)
# Prometheus is published on host port 9090 by compose.observability.yaml
PROM_URL=http://localhost:9090
# Jaeger is reached through the frontend proxy on port 8080 (/jaeger/ui/api/v3/...)
JAEGER_URL=http://localhost:8080
# OpenSearch host port is dynamic. Find it with: docker port opensearch 9200
# Example output 0.0.0.0:55012 -> OPENSEARCH_URL=http://localhost:55012
OPENSEARCH_URL=
EVIDENCE_DIR=evidence
TELEMETRY_TIMEOUT_S=10

# LLM through LangChain. Default: Google Gemini free tier (key from https://aistudio.google.com/apikey).
# Test with: python cli.py check-llm. Free daily quotas differ a lot per model: the newest Flash models allowed only
# ~20 requests/day on our key (one investigation uses up to 6), Flash-Lite allows far more. On 503/429/504 the agent
# retries once, then switches to LLM_FALLBACK_MODEL for the rest of the run.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# Alternative free tier: Groq (key from https://console.groq.com/keys)
# LLM_PROVIDER=groq
# LLM_MODEL=
# GROQ_API_KEY=

# Grafana (Team 6's own instance from grafana/compose.yaml, NOT the organisers' Grafana).
# Each investigation is posted there as an annotation. Empty GRAFANA_URL = disabled.
GRAFANA_URL=http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=incident-agent
