# Copy to .env (never commit .env), or generate the URLs with: python cli.py endpoints --write-env
# Host ports for Jaeger, OpenSearch and Grafana are dynamic and change whenever the stack restarts.
# Prometheus is published on host port 9090 by compose.observability.yaml
PROM_URL=http://localhost:9090
# Jaeger query port directly (docker port jaeger 16686), so a frontend-proxy fault does not hide traces.
# The frontend proxy (http://localhost:8080) also works while it is healthy.
JAEGER_URL=
# docker port opensearch 9200 -> e.g. 0.0.0.0:55012 -> OPENSEARCH_URL=http://localhost:55012
OPENSEARCH_URL=
# Browser only (docker port grafana 3000)
GRAFANA_URL=
EVIDENCE_DIR=evidence
TELEMETRY_TIMEOUT_S=10

# LLM (Anthropic). The key is read from the environment; never commit it.
ANTHROPIC_MODEL=
# ANTHROPIC_API_KEY=

# Action API: catalog JSON written from the organiser's official contract (see ACTION_API.md).
# Without it, remediation always escalates. Live dispatch also needs provenance "organiser" and the base URL.
ACTION_API_CATALOG=
ACTION_API_URL=
# Optional, if the contract requires a token (the env var name is set in the catalog's token_env)
# ACTION_API_TOKEN=
# Operator kill switch: 1 blocks every state-changing action (or: python cli.py kill-switch on)
INCIDENT_AGENT_KILL_SWITCH=0
INCIDENT_AGENT_APPROVER=
