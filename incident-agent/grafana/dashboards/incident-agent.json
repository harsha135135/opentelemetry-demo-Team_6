{
  "uid": "incident-agent",
  "title": "Incident Agent",
  "description": "Diagnoses posted by the Team 6 read-only incident agent, over the demo's live metrics.",
  "tags": ["incident-agent"],
  "timezone": "Asia/Kolkata",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "Agent diagnoses",
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "iconColor": "red",
        "target": {"type": "tags", "tags": ["incident-agent"], "limit": 100, "matchAny": false}
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "annolist", "title": "Agent diagnoses (newest first) - hover or click for details",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 10},
      "options": {
        "onlyFromThisDashboard": false, "onlyInTimeRange": false, "tags": ["incident-agent"],
        "limit": 20, "showUser": false, "showTime": true, "showTags": true,
        "navigateToPanel": false, "navigateBefore": "5m", "navigateAfter": "5m"
      }
    },
    {
      "id": 2, "type": "timeseries", "title": "Error rate by service (span metrics, 3 min)",
      "datasource": {"type": "prometheus", "uid": "demo-prometheus"},
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 9},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [{
        "refId": "A", "legendFormat": "{{service_name}}",
        "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{status_code=\"STATUS_CODE_ERROR\",service_name!~\"flagd.*\"}[3m])) / sum by (service_name) (rate(traces_span_metrics_calls_total{service_name!~\"flagd.*\"}[3m]))"
      }]
    },
    {
      "id": 3, "type": "timeseries", "title": "p95 latency by service (3 min)",
      "datasource": {"type": "prometheus", "uid": "demo-prometheus"},
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 9},
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0}, "overrides": []},
      "targets": [{
        "refId": "A", "legendFormat": "{{service_name}}",
        "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name!~\"flagd.*\"}[3m])))"
      }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Container CPU (% of one core, from the CPU-time counter)",
      "datasource": {"type": "prometheus", "uid": "demo-prometheus"},
      "gridPos": {"x": 0, "y": 19, "w": 8, "h": 9},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0}, "overrides": []},
      "targets": [{
        "refId": "A", "legendFormat": "{{container_name}}",
        "expr": "rate(container_cpu_usage_nanoseconds_total{container_name!~\"flagd.*|agent-grafana\"}[3m]) / 1e7"
      }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Container memory (% of limit)",
      "datasource": {"type": "prometheus", "uid": "demo-prometheus"},
      "gridPos": {"x": 8, "y": 19, "w": 8, "h": 9},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "targets": [{
        "refId": "A", "legendFormat": "{{container_name}}",
        "expr": "container_memory_percent_ratio{container_name!~\"flagd.*|agent-grafana\"}"
      }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Container restarts (last 30 min)",
      "datasource": {"type": "prometheus", "uid": "demo-prometheus"},
      "gridPos": {"x": 16, "y": 19, "w": 8, "h": 9},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "targets": [{
        "refId": "A", "legendFormat": "{{container_name}}",
        "expr": "resets(container_uptime_seconds{container_name!~\"flagd.*|agent-grafana\"}[30m]) > 0"
      }]
    }
  ]
}
