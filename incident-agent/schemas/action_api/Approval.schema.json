{
  "$id": "https://incident-zero.team6.local/schemas/action_api/Approval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An approval request. The one-time code is printed only on the Action API operator console; it is never returned.",
  "properties": {
    "approval_id": {
      "pattern": "^apr-[a-f0-9]{16}$",
      "title": "Approval Id",
      "type": "string"
    },
    "code_delivery": {
      "const": "action-api-console",
      "default": "action-api-console",
      "title": "Code Delivery",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "failed_attempts": {
      "default": 0,
      "title": "Failed Attempts",
      "type": "integer"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "payload_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Digest",
      "type": "string"
    },
    "requested_by": {
      "title": "Requested By",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "consumed",
        "rejected",
        "expired",
        "locked"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "status",
    "incident_id",
    "operation",
    "target",
    "payload_digest",
    "requested_by",
    "created_at",
    "expires_at"
  ],
  "title": "Approval",
  "type": "object"
}
