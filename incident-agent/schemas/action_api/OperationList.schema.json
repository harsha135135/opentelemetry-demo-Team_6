          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "allowed_targets",
        "parameters",
        "risk",
        "reversible",
        "idempotent",
        "expected_effect"
      ],
      "title": "OperationSpec",
      "type": "object"
    }
  },
  "$id": "https://incident-zero.team6.local/schemas/action_api/OperationList.schema.json",
