          "title": "Idempotent",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Parameters",
          "type": "object"
        },
        "required": {
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        },
        "reversible": {
          "title": "Reversible",
          "type": "boolean"
        },
        "risk": {
          "title": "Risk",
          "type": "string"
        },
        "target_kind": {
          "const": "service",
