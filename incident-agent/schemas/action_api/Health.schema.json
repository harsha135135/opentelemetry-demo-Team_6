{
  "$id": "https://incident-zero.team6.local/schemas/action_api/Health.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "title": "Api Version",
      "type": "string"
    },
    "executor": {
      "enum": [
        "docker",
        "simulate"
      ],
      "title": "Executor",
      "type": "string"
    },
    "kill_switch_active": {
      "title": "Kill Switch Active",
      "type": "boolean"
    },
    "status": {
      "const": "ok",
      "default": "ok",
      "title": "Status",
      "type": "string"
    },
    "time": {
      "format": "date-time",
      "title": "Time",
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "executor",
    "kill_switch_active",
    "time"
  ],
  "title": "Health",
  "type": "object"
}
